# Credentials and local configuration
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
node.zip
credentials*
secrets*

# Python and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
node_modules/
.coverage
coverage.xml

# Local ComfyUI data and downloaded model/media files
models/
model_cache/
input/
output/
temp/
cache/
media/
tmp*/
tests/tmp*/
*.mp4
*.mkv
*.mov
*.webm
*.avi
*.wav
*.mp3
*.flac
*.png
*.jpg
*.jpeg

# Licensed inference source and the published generic face mask are package assets.
!artist_studio/latentsync_vendor/models/
artist_studio/latentsync_vendor/models/*
!artist_studio/latentsync_vendor/models/*.py
!artist_studio/latentsync_vendor/mask.png

# Keep the distributable frontend and example workflows visible if a broader
# ignore rule is added by a consuming repository.
!web/
!web/**
!workflows/
!workflows/**

# LongCat machine configuration is never distributed.
longcat.local.json*
.venv/

# Workstation-only VoiceDesign settings.
qwen_voice_design.local.json*
