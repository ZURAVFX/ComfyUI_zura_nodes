{
  "id": "02-invert",
  "name": "02 - Invert colours (no model)",
  "description": "Inverts the selected frames in bounded image batches using ComfyUI ImageInvert. No model downloads required.",
  "mode": "batch",
  "input": {
    "node": "1",
    "field": "folder"
  },
  "output": {
    "node": "3"
  },
  "workflow": {
    "1": {
      "class_type": "ComfyLinkLoadFrames",
      "inputs": {
        "folder": "ComfyLink/00000000000000000000000000000000",
        "fps": 25.0
      },
      "_meta": {
        "title": "AE_INPUT"
      }
    },
    "3": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "2",
          0
        ],
        "filename_prefix": "ComfyLink/test"
      },
      "_meta": {
        "title": "AE_OUTPUT"
      }
    },
    "2": {
      "class_type": "ImageInvert",
      "inputs": {
        "image": [
          "1",
          0
        ]
      }
    }
  },
  "revision": "batch-elementwise-v1",
  "batchPolicy": "elementwise-v1"
}
