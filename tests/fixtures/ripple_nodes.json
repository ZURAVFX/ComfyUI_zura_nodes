{
  "ZuraPaintoutFullFrame": {
    "input": {
      "required": {
        "plate_path": [
          "STRING",
          {
            "default": ""
          }
        ],
        "colour_space": [
          [
            "auto",
            "acescg",
            "acescct",
            "hlg_rec2020",
            "pq_rec2020",
            "linear_rec709",
            "srgb_display",
            "rec709_gamma24",
            "rec709_oetf"
          ]
        ],
        "start_frame": [
          "INT",
          {
            "default": 0,
            "min": 0,
            "max": 100000
          }
        ],
        "frame_count": [
          "INT",
          {
            "default": 81,
            "min": 1,
            "max": 993
          }
        ],
        "sequence_fps": [
          "FLOAT",
          {
            "default": 25,
            "min": 1,
            "max": 120,
            "step": 0.01
          }
        ],
        "context_pixels": [
          "INT",
          {
            "default": 128,
            "min": 32,
            "max": 2048
          }
        ],
        "max_crop_side": [
          "INT",
          {
            "default": 768,
            "min": 128,
            "max": 2048
          }
        ],
        "repair_grow": [
          "INT",
          {
            "default": 16,
            "min": 0,
            "max": 256
          }
        ],
        "feather_pixels": [
          "INT",
          {
            "default": 0,
            "min": 0,
            "max": 256
          }
        ]
      },
      "optional": {
        "processing_mode": [
          [
            "HDR (ACEScct)",
            "SDR (sRGB)"
          ]
        ],
        "framing_mode": [
          [
            "Plate resolution (stretch to next grid)",
            "Smart crop (experimental)",
            "Full frame (original method)",
            "Full frame (fit, no crop)",
            "Source resolution (pad, no resize)"
          ]
        ],
        "render_width": [
          "INT",
          {
            "default": 1152,
            "min": 64,
            "max": 4096
          }
        ],
        "render_height": [
          "INT",
          {
            "default": 640,
            "min": 64,
            "max": 4096
          }
        ]
      }
    },
    "output": [
      "IMAGE",
      "MASK",
      "ZURA_PLATE",
      "INT",
      "INT",
      "INT",
      "FLOAT",
      "STRING"
    ]
  },
