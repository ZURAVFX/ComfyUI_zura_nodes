# Do not include credentials, caches, downloaded models, or local media in a
# Comfy Registry package.
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
credentials*
secrets*
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
node_modules/
tests/
.github/
RELEASING.md
pyproject.toml.template
models/
model_cache/
input/
output/
temp/
cache/
media/
tmp*/
tests/tmp*/
*.mp4
*.mkv
*.mov
*.webm
*.avi
*.wav
*.mp3
*.flac
*.png
*.jpg
*.jpeg

# Licensed inference source and its generic face mask are package assets.
!artist_studio/latentsync_vendor/models/
artist_studio/latentsync_vendor/models/*
!artist_studio/latentsync_vendor/models/*.py
!artist_studio/latentsync_vendor/mask.png

# The package UI and example workflows are part of the release.
!/web/
!/web/**
!/workflows/
/workflows/*
!/workflows/Audio - Replace Speech (LongCat).json
!/workflows/Audio - Clone a Voice (LongCat).json
!/workflows/Audio - Text to Speech (LongCat).json
!/workflows/Audio - Design a Voice (Qwen).json
!/workflows/Audio - Design a Voice (Qwen to LongCat).json
!/workflows/Video - Replace Speech (LTX INT8).json
!/workflows/Video - Change Camera (H3).json
!/workflows/Video - Multicam (H3 Advanced).json
!/workflows/Video - Replace a Character (Wan 2.2).json
!/workflows/Image - Build a Starting Frame.json
!/workflows/Image - Build a Starting Frame (3 References).json
!/workflows/Image - Use a Finished Starting Frame.json
!/workflows/Utility - Improve a Prompt (Gemma 4).json
!/workflows/Reference - Mask and Roto (SAM3).json
!/workflows/Reference - Head and Face Swap (H3).json
!/workflows/Reference - Speedboost Comparison (H3).json

# LongCat machine configuration is never distributed.
longcat.local.json*
.venv/

# Workstation-only VoiceDesign settings.
qwen_voice_design.local.json*

# Local optional Parakeet interpreter and model paths.
parakeet.local.json*

# UI build sources are not runtime dependencies.
/tools/
/work/
