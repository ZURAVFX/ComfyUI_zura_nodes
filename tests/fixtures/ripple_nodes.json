  "LTXAddVideoICLoRAGuide": {
    "input": {
      "required": {
        "positive": [
          "CONDITIONING",
          {}
        ],
        "negative": [
          "CONDITIONING",
          {}
        ],
        "vae": [
          "VAE",
          {}
        ],
        "latent": [
          "LATENT",
          {
            "tooltip": "Video-only latent to condition. Must be a 5D video latent (batch, channels, frames, height, width)."
          }
        ],
        "image": [
          "IMAGE",
          {}
        ],
        "frame_idx": [
          "INT",
          {
            "tooltip": "RoPE position of the reference, in pixel frames.\n0 aligns the reference with the generated clip. Use for video references.\n>0 places the reference at a specific pixel-frame position in the clip.\n-1 places the reference outside the generated frame range, while still using it for attention conditioning. Use for single-image references.\nFor multi-frame references, >0 values are rounded down to 1 mod 8.",
            "default": 0,
            "min": -9999,
            "max": 9999
          }
        ],
        "strength": [
          "FLOAT",
          {
            "default": 1.0,
            "min": 0.0,
            "max": 1.0,
            "step": 0.01
          }
        ],
        "latent_downscale_factor": [
          "FLOAT",
          {
            "tooltip": "For IC-LoRA on small grid. 1 means original size, 2 means half size, 3 means third, etc.",
            "default": 1.0,
            "min": 1.0,
            "max": 10.0,
            "step": 1.0
          }
        ],
        "crop": [
          "COMBO",
          {
            "tooltip": "Crop mode when resizing. 'center' crops to fit, 'disabled' stretches to fit.",
            "default": "disabled",
            "multiselect": false,
            "options": [
              "disabled",
              "center"
            ]
          }
        ],
        "use_tiled_encode": [
          "BOOLEAN",
          {
            "tooltip": "Enable tiled VAE encoding for large resolutions/long videos to reduce memory usage.",
            "default": false
          }
        ],
        "tile_size": [
          "INT",
          {
            "tooltip": "Spatial tile size for tiled encoding. Only used when use_tiled_encode is enabled.",
            "default": 256,
            "min": 64,
            "max": 512,
            "step": 32
          }
        ],
        "tile_overlap": [
          "INT",
          {
            "tooltip": "Overlap between tiles for tiled encoding. Only used when use_tiled_encode is enabled.",
            "default": 64,
            "min": 16,
            "max": 256,
            "step": 16
          }
        ]
      },
      "optional": {
        "use_streaming": [
          "BOOLEAN",
          {
            "tooltip": "Off (default): encode the whole clip as one IC-LoRA guide. On: re-encode one fresh guide per LTXVTiledFusionSampler temporal window and write the plan the sampler reads. Set tile_frames on this node and the sampler to the same value (97 for LTX).",
            "default": false
          }
        ],
        "tile_frames": [
          "INT",
          {
            "tooltip": "Window length in pixel frames, used only when use_streaming is on. Snapped to 8n+1. Must match LTXVTiledFusionSampler. Ignored when use_streaming is off.",
            "default": 97,
            "min": 0,
            "max": 1000,
            "step": 1
          }
        ]
      }
    },
    "output": [
      "CONDITIONING",
      "CONDITIONING",
      "LATENT"
    ]
  },
