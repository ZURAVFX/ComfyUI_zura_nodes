{
  "id": "02-invert",
  "name": "02 - Invert colours (no model)",
  "description": "A visible test of the whole bridge using ComfyUI ImageInvert. This is not a generative AI preset.",
  "mode": "frames",
  "input": {
    "node": "1",
    "field": "image"
  },
  "output": {
    "node": "3"
  },
  "workflow": {
    "1": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "placeholder.png"
      },
      "_meta": {
        "title": "AE_INPUT"
      }
    },
    "3": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "2",
          0
        ],
        "filename_prefix": "ComfyLink/test"
      },
      "_meta": {
        "title": "AE_OUTPUT"
      }
    },
    "2": {
      "class_type": "ImageInvert",
      "inputs": {
        "image": [
          "1",
          0
        ]
      }
    }
  }
}